rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Default deny
    match /{document=**} {
      allow read, write: if false;
    }

    // Helper functions
    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isValidId(id) {
      return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    // Connection test document
    match /test/connection {
      allow read: if true;
    }

    // Suppliers directory
    match /suppliers/{supplierId} {
      allow read: if true;
      allow create: if isSignedIn() && isValidId(supplierId) &&
        request.resource.data.ownerId == request.auth.uid &&
        request.resource.data.name is string && request.resource.data.name.size() <= 120 &&
        request.resource.data.category is string && request.resource.data.category.size() <= 80;
      allow update: if isSignedIn() && isValidId(supplierId) &&
        resource.data.ownerId == request.auth.uid &&
        request.resource.data.ownerId == resource.data.ownerId;
      allow delete: if isSignedIn() && isValidId(supplierId) &&
        resource.data.ownerId == request.auth.uid;
    }

    // Products catalog
    match /products/{productId} {
      allow read: if true;
      allow create: if isSignedIn() && isValidId(productId) &&
        request.resource.data.supplierId is string &&
        request.resource.data.title is string && request.resource.data.title.size() <= 150 &&
        request.resource.data.unitPrice is number;
      allow update: if isSignedIn() && isValidId(productId);
      allow delete: if isSignedIn() && isValidId(productId);
    }

    // Procurement orders
    match /orders/{orderId} {
      allow read: if isSignedIn() && isValidId(orderId) &&
        (resource.data.buyerId == request.auth.uid || resource.data.supplierOwnerId == request.auth.uid || resource.data.buyerEmail == request.auth.token.email);
      allow create: if isSignedIn() && isValidId(orderId) &&
        request.resource.data.buyerId == request.auth.uid &&
        request.resource.data.totalAmount is number;
      allow update: if isSignedIn() && isValidId(orderId) &&
        (resource.data.buyerId == request.auth.uid || resource.data.supplierOwnerId == request.auth.uid);
      allow delete: if false;
    }

    // Institutions / Buyer Profiles
    match /institutions/{institutionId} {
      allow read: if isSignedIn() && isValidId(institutionId);
      allow create: if isSignedIn() && isValidId(institutionId) &&
        request.resource.data.ownerId == request.auth.uid &&
        request.resource.data.name is string && request.resource.data.name.size() <= 120;
      allow update: if isSignedIn() && isValidId(institutionId) &&
        resource.data.ownerId == request.auth.uid;
      allow delete: if isSignedIn() && isValidId(institutionId) &&
        resource.data.ownerId == request.auth.uid;
    }
  }
}
